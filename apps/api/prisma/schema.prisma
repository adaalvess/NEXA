// NEXA — Schema Prisma
//
// Fonte: Blueprint de Implementação do MVP, secção 3 (schema inicial), refinado
// mantendo rastreabilidade explícita com:
//   - ADR-001 (Multi-Tenancy e Isolamento de Dados)
//   - ADR-003 (Base de Dados e ORM)
//   - ADR-004 (Autenticação, Sessão e Autorização)
//   - Data Model Conceptual v1.1
//   - Data & Consistency Rules v1.1
//
// ATUALIZAÇÃO (Passo 4, 2026-07-06) — Row-Level Security (Camada 2, ADR-001 3.3)
// ATIVA: ver migração 20260706105932_enable_row_level_security e Especificação
// Técnica do Passo 4 (docs/04-implementation-blueprint/03-especificacao-tecnica-
// passo-4-camada1-autorizacao.md). O runtime de negócio liga-se com o role
// dedicado `nexa_app` (sujeito a RLS, sem DDL); o runtime da Fundação
// (registo/sessão) usa `nexa_fundacao` (BYPASSRLS, sem DDL — exceção
// documentada para operações transversais sem tenant ainda conhecido);
// migrações continuam a usar `nexa_dev` (owner). Nota original do Passo 2,
// mantida por historial: este schema já preparava a estrutura (tenant_id em
// toda a tabela de negócio, indexado) antes de a Camada 2 estar ativa —
// a ativação ficou deliberadamente adiada até o middleware de tenant (Camada 1)
// e o utilizador de BD dedicado existirem, evitando falsa sensação de segurança.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// FUNDAÇÃO
// ============================================================================

/// A Empresa é o Workspace Context — a unidade de isolamento multi-tenant
/// (ADR-001, Data Model Conceptual 3.1/3.2). Toda a restante informação de
/// negócio existe dentro de uma Empresa e referencia o seu id como tenant_id.
model Empresa {
  id               String   @id @default(cuid())
  nome             String
  pais             String
  setor            String?
  estadoSubscricao String   @default("trial") // trial | ativa | limitada | cancelada
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  utilizadores      Utilizador[]
  departamentos     Departamento[]
  sessoes           Sessao[]
  processos         Processo[]
  clientes          Cliente[]
  interacoes        Interacao[]
  sugestoesIA       SugestaoIA[]
  usosIAMensal      UsoIAMensal[]
  notificacoes      Notificacao[]
  partilhas         Partilha[]
  registosAuditoria RegistoAuditoria[]
  regrasPermissao   RegraPermissao[]
  subscricaoPlano   SubscricaoPlano?
}

/// Papel RBAC predefinido (Vision Document, RBAC; Passo 5) — enum, não String
/// (Blueprint D4, ajuste de tipo): reforça a fronteira única de validação ao
/// nível da própria base de dados. `super_admin` nunca é atribuível através de
/// nenhum fluxo de uma Empresa cliente (RN-04, UC-02) — só estrutural neste
/// passo, sem lógica de bypass cross-tenant (Especificação Técnica do Passo 5,
/// 2.1.A) — essa lógica fica para o Passo 6 (Registo de Auditoria).
enum Papel {
  super_admin
  admin_empresa
  gestor
  colaborador
  convidado
}

model Utilizador {
  id             String        @id @default(cuid())
  empresaId      String
  empresa        Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome           String
  email          String
  passwordHash   String // Argon2id (ADR-004, 3.4) — nunca texto plano, nunca bcrypt
  papel          Papel
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId, empresaId], references: [id, empresaId])

  // Soft-delete por defeito (Data & Consistency Rules, 3.4) — null = ativo
  eliminadoEm DateTime?

  // Metadados de auditoria resumida por entidade (Data & Consistency Rules, 3.7)
  // — resumo rápido; o histórico completo e imutável vive em RegistoAuditoria.
  criadoPor     String?
  atualizadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessoes              Sessao[]
  processosResponsavel Processo[]    @relation("ProcessoResponsavel")
  clientesOwner        Cliente[]     @relation("ClienteOwner")
  sugestoesIA          SugestaoIA[]
  notificacoes         Notificacao[]
  partilhasRecebidas   Partilha[]    @relation("PartilhaConvidado")
  partilhasConcedidas  Partilha[]    @relation("PartilhaConcedidaPor")

  // Unicidade de email com escopo de tenant — o mesmo email pode existir em
  // Empresas diferentes (Data & Consistency Rules, 3.2), nunca duplicado dentro
  // da mesma Empresa.
  @@unique([empresaId, email])
  // Chave composta que permite às entidades relacionadas (Processo, Cliente, ...)
  // aplicar constraints de FK com escopo de tenant (ADR-003, 3.3 — Camada 3 de
  // Defense in Depth: estruturalmente impossível referenciar um Utilizador de
  // outra Empresa).
  @@unique([id, empresaId])
  @@index([empresaId])
}

/// Sessão do lado do servidor (ADR-004, 3.2) — nunca JWT. Herda o isolamento por
/// tenant_id (ADR-004, Validação Arquitetural 5): uma sessão nunca é visível a
/// partir do contexto de outra Empresa.
model Sessao {
  id           String     @id @default(cuid())
  empresaId    String
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId, empresaId], references: [id, empresaId], onDelete: Cascade)
  criadaEm     DateTime   @default(now())
  expiraEm     DateTime // renovação deslizante, 7 dias (ADR-007, 3.5)

  @@index([empresaId])
  @@index([utilizadorId])
}

model Departamento {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String

  eliminadoEm DateTime?

  criadoPor     String?
  atualizadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  utilizadores Utilizador[]
  processos    Processo[]

  @@unique([id, empresaId])
  @@index([empresaId])
}

/// Registo de Auditoria — append-only (Data & Consistency Rules, 3.3; regra
/// não-negociável #9): nunca UPDATE nem DELETE, só INSERT. Entidade transversal
/// (Data Model Conceptual, 3.3) — relaciona-se com qualquer entidade
/// referenciável via (entidade, entidadeId), por isso não tem FK direta à
/// entidade referenciada (o alvo varia por tipo).
model RegistoAuditoria {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ator       String // utilizadorId ou "ia"
  acao       String
  entidade   String
  entidadeId String
  /// "A alteração efetuada" (FR-07) — Especificação Técnica do Passo 6, §3.3.
  /// jsonb, formato por categoria de ação, nunca segredos. Imutável como o
  /// resto da linha — reforçado a nível de BD por trigger (§3.4 desse
  /// documento), não só por convenção.
  detalhe    Json?
  timestamp  DateTime @default(now())

  @@index([empresaId, timestamp])
}

/// Nível de acesso concedido por uma Partilha (Functional Specifications,
/// 3.1) — só "leitura" possível no MVP; edição por Convidado fora de âmbito
/// (Vision Document, RBAC). Enum pronto para uma futura extensão sem
/// redesenho (Especificação Técnica do Passo 7, 2.1.B).
enum NivelAcessoPartilha {
  leitura
}

/// Concessão explícita de acesso a uma entidade específica a um Utilizador com
/// papel Convidado (Data Model Conceptual, 3.3). entidadeId é polimórfico
/// (aponta para Cliente ou Processo conforme entidadeTipo) — sem FK direta pela
/// mesma razão estrutural do Registo de Auditoria; a validação de que
/// entidadeId pertence à mesma Empresa é responsabilidade da camada de acesso a
/// dados única (Camada 1). Revogação por soft-delete (revogadoEm), mesmo
/// padrão das restantes entidades de negócio (Data & Consistency Rules, 3.4)
/// — Especificação Técnica do Passo 7, 2.1.C.
model Partilha {
  id             String              @id @default(cuid())
  empresaId      String
  empresa        Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  entidadeTipo   String // "cliente" | "processo"
  entidadeId     String
  convidadoId    String
  convidado      Utilizador          @relation("PartilhaConvidado", fields: [convidadoId, empresaId], references: [id, empresaId], onDelete: Cascade)
  concedidoPorId String
  concedidoPor   Utilizador          @relation("PartilhaConcedidaPor", fields: [concedidoPorId, empresaId], references: [id, empresaId])
  nivelAcesso    NivelAcessoPartilha @default(leitura)
  revogadoEm     DateTime?
  createdAt      DateTime            @default(now())

  @@index([empresaId, entidadeTipo, entidadeId])
  @@index([empresaId, convidadoId])
}

/// Regras de permissão granulares por Empresa (FR-04; Data Model Conceptual,
/// 3.2, "Papel e Regras de Permissão"; Especificação Técnica do Passo 5, 3.2).
/// Override explícito sobre a matriz de papéis predefinida (configuração de
/// código, System Design Principles 3.5): a ausência de linha para
/// (papel, modulo, acao) usa o default do papel; a presença de uma linha
/// sobrepõe-se sempre, em qualquer sentido (concede ou revoga).
model RegraPermissao {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  papel     Papel // nunca super_admin — validado na fronteira única (RN-04)
  modulo    String // "fundacao" | "dashboard" | "processos" | "crm" | "ia" | "comercial"
  acao      String // vocabulário próprio por módulo

  permitido Boolean

  criadoPor     String?
  atualizadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([empresaId, papel, modulo, acao])
  @@index([empresaId])
}

// ============================================================================
// PROCESSOS E TAREFAS
// ============================================================================

/// Estado de um Processo/Tarefa (Functional Specifications, 3.3) — enum desde
/// o Passo 9 (Blueprint D4, ajuste de tipo, mesmo padrão do `Papel` no
/// Passo 5), antes `String` com os mesmos 3 valores literais.
enum EstadoProcesso {
  por_fazer
  em_curso
  concluida
}

model Processo {
  id             String         @id @default(cuid())
  empresaId      String
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo         String
  descricao      String? // Especificação Técnica do Passo 9, 2.2 — em falta desde o Passo 2
  responsavelId  String
  responsavel    Utilizador     @relation("ProcessoResponsavel", fields: [responsavelId, empresaId], references: [id, empresaId])
  departamentoId String?
  departamento   Departamento?  @relation(fields: [departamentoId, empresaId], references: [id, empresaId])
  clienteId      String?
  cliente        Cliente?       @relation(fields: [clienteId, empresaId], references: [id, empresaId])
  estado         EstadoProcesso @default(por_fazer)
  prazo          DateTime?

  eliminadoEm DateTime?

  criadoPor     String?
  atualizadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([id, empresaId])
  @@index([empresaId])
}

// ============================================================================
// CRM
// ============================================================================

/// Estado de uma Oportunidade associada a um Cliente (Functional
/// Specifications, 3.4) — enum desde o Passo 10 (Blueprint D4, ajuste de
/// tipo, mesmo padrão do `Papel` no Passo 5 e `EstadoProcesso` no Passo 9).
enum EstadoOportunidade {
  prospecao
  negociacao
  fechada_ganha
  fechada_perdida
}

model Cliente {
  id                 String              @id @default(cuid())
  empresaId          String
  empresa            Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome               String
  tipo               String // empresa_cliente | contacto_individual
  contactoPrincipal  String? // email ou telefone — Especificação Técnica do Passo 10, 2.1.A
  ownerId            String
  owner              Utilizador          @relation("ClienteOwner", fields: [ownerId, empresaId], references: [id, empresaId])
  estadoOportunidade EstadoOportunidade?

  eliminadoEm DateTime?

  criadoPor     String?
  atualizadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  interacoes Interacao[]
  processos  Processo[]

  @@unique([id, empresaId])
  @@index([empresaId])
}

model Interacao {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Cascade)
  tipo      String // chamada | reuniao | nota | outro
  descricao String? // Especificação Técnica do Passo 10, 2.1.B
  data      DateTime @default(now())

  criadoPor     String?
  atualizadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([empresaId, clienteId])
}

// ============================================================================
// ASSISTENTE DE IA
// ============================================================================

/// Sugestão/Conversa de IA (Data Model Conceptual, 3.2). Estado nunca inclui
/// "executada automaticamente" — a IA nunca executa uma ação sem confirmação
/// humana explícita (regra não-negociável #16, ADR-005). entidadeRef é
/// polimórfico pela mesma razão estrutural de Partilha.entidadeId.
model SugestaoIA {
  id              String     @id @default(cuid())
  empresaId       String
  empresa         Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  utilizadorId    String
  utilizador      Utilizador @relation(fields: [utilizadorId, empresaId], references: [id, empresaId], onDelete: Cascade)
  tipo            String // pergunta | sugestao_acao
  entidadeRef     String?
  estado          String     @default("pendente") // pendente | aceite | rejeitada — "pergunta" nasce sempre "aceite" (Especificação Técnica do Passo 16, D4)
  fornecedorUsado String
  /// Conteúdo, sujeito a retenção configurável (PSD-003; Especificação
  /// Técnica do Passo 16, 3.1/Decisão a Validar B) — `null` se
  /// `IA_RETER_CONTEUDO=false`; nunca devolvido pela API além de
  /// `IA_RETENCAO_CONTEUDO_DIAS`, mesmo que ainda presente na BD.
  conteudoPergunta String?
  conteudoResposta String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([empresaId])
}

/// Contador de utilização mensal do AI Gateway por Empresa (Especificação
/// Técnica do Passo 15, 3.5) — descoberta real durante a implementação:
/// `SubscricaoPlano.limiteUsoIA` (Passo 2) é um teto, nunca um contador, e
/// `SubscricaoPlano` nunca é criado no registo (deliberadamente adiado para o
/// M4, ver CLAUDE.md 3.2). Este modelo é aditivo e não antecipa nenhuma
/// decisão comercial — `anoMes` (formato "YYYY-MM") é a chave natural do
/// período; reinício mensal é implícito (nunca há linha para um mês novo até
/// à primeira chamada desse mês).
model UsoIAMensal {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  anoMes    String
  contagem  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([empresaId, anoMes])
  @@index([empresaId])
}

// ============================================================================
// DASHBOARD / TRANSVERSAL
// ============================================================================

model Notificacao {
  id               String     @id @default(cuid())
  empresaId        String
  empresa          Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  destinatarioId   String
  destinatario     Utilizador @relation(fields: [destinatarioId, empresaId], references: [id, empresaId], onDelete: Cascade)
  tipoEvento       String
  entidadeOrigemId String
  lida             Boolean    @default(false)
  createdAt        DateTime   @default(now())

  @@index([empresaId, destinatarioId])
}

// ============================================================================
// COMERCIAL
// ============================================================================

model SubscricaoPlano {
  id                    String   @id @default(cuid())
  empresaId             String   @unique
  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  plano                 String // starter | professional | enterprise
  estado                String   @default("trial")
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  limiteUtilizadores    Int
  limiteArmazenamentoMb Int
  limiteUsoIA           Int
  trialIniciadoEm       DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
