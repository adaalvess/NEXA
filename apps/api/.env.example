# NEXA API — Variáveis de Ambiente
# Nunca preencher este ficheiro com valores reais nem o committar com segredos.
# Consistente com Coding Standards (3.6) e Security & Access Principles (3.8).

# Porta do servidor
PORT=4000

# Base de dados (Neon PostgreSQL, ADR-003/007) — connection string com RLS habilitado.
# A partir do Passo 4: este utilizador de runtime NUNCA deve ser o owner das
# tabelas (Least Privilege) — só SELECT/INSERT/UPDATE/DELETE, sujeito a RLS.
# Migrações correm sempre com o utilizador owner, nunca com este.
DATABASE_URL="postgresql://user:password@host:5432/nexa?schema=public"

# Fundação (registo, resolução de sessão) — mesmos privilégios DML acima,
# mas com BYPASSRLS: exceção documentada para operações transversais sem
# tenant ainda conhecido (bootstrap do registo, resolução de sessão).
FUNDACAO_DATABASE_URL="postgresql://user_fundacao:password@host:5432/nexa?schema=public"

# Consulta cross-tenant do Registo de Auditoria pelo Super Admin (Passo 6) —
# BYPASSRLS, mas só SELECT e só na tabela RegistoAuditoria (Least Privilege).
AUDITORIA_INTERNA_DATABASE_URL="postgresql://user_auditoria_interna:password@host:5432/nexa?schema=public"

# URL do frontend, para configuração de CORS (ADR-006/007)
WEB_APP_URL="http://localhost:3000"

# Sessões (ADR-004) — segredo para assinatura de cookies, gerar com openssl rand -hex 32
SESSION_SECRET=""

# Argon2id (ADR-004) — parâmetros de custo, ajustar conforme capacidade do servidor
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# Fornecedores de IA (ADR-005, AI Gateway) — nunca hardcoded no código
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Stripe (ADR-008)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry (ADR-007, 3.4)
SENTRY_DSN=""
